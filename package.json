{
	"name": "discord",
	"version": "0.7.2",
	"description": "Discord server management CLI built on Bun and argc.",
	"bin": {
		"discord": "src/main.ts"
	},
	"type": "module",
	"scripts": {
		"start": "bun run src/main.ts",
		"schema": "bun run src/main.ts --schema",
		"fmt": "bunx oxfmt",
		"fmt:check": "bunx oxfmt --check",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test",
		"check": "bun run fmt:check && bun run typecheck && bun test",
		"build": "bun build src/main.ts --outfile=dist/discord --target=bun --minify && chmod +x dist/discord"
	},
	"dependencies": {
		"@toon-format/toon": "^2.1.0",
		"@valibot/to-json-schema": "^1.5.0",
		"argc": "github:ethan-huo/argc",
		"valibot": "^1.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"oxfmt": "^0.35.0",
		"typescript": "^5.7.2"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
